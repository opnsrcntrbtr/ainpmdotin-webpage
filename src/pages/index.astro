---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { faqSchema } from '../data/site';
import ProjectCards from '../components/ProjectCards.astro';
import BookCTA from '../components/BookCTA.astro';
import { SKILLS } from '../data/skills';
import { PROJECTS } from '../data/projects';

const articles = (await getCollection('articles')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const updated = new Date('2026-11-03');
const evidence = SKILLS.reduce((n, s) => n + s.evidence.length, 0);
const latest = articles.slice(0, 3);

const faq = [
  { q: 'What is AI-native product management?', a: 'AI-native product management is the practice of building products where an AI model is the core of the experience rather than an add-on. The product manager specifies behaviour with evaluation sets, measures quality as a rate, manages inference cost per task and designs trust controls such as citations, abstention and consent from the start.' },
  { q: 'What is AINPM.in?', a: 'AINPM.in is the site of Ian Pinto, a Technical Product / Program Manager in India. It brings together his open-source AI products, a field guide and articles on AI-native product management, a skills matrix with public evidence, and paid consultations.' },
  { q: 'What is SEBI Circular RAG?', a: 'SEBI Circular RAG is an open-source assistant that answers questions over 1,490 SEBI circulars. It cites every claim, flags superseded circulars, can answer as of a past date and refuses when evidence is missing. A live demo runs on Hugging Face and the code and dataset are public.' },
  { q: 'Which AI regulations apply to product teams in India?', a: 'India has no single AI Act. Product teams track MeitY\'s India AI Governance Guidelines, the DPDP Act and Rules (consent managers from 13 November 2026, full compliance by 13 May 2027), IT Rules on labelling AI-generated content, RBI\'s FREE-AI framework and SEBI\'s forthcoming AI/ML guidelines.' },
  { q: 'How do I become an AI-native product manager?', a: 'Start by building a small evaluation set of about 50 real examples for a feature you own, prototype against it with AI coding tools, track cost and latency per task, and learn the regulation that applies to your sector. Publishing a working project with its evaluation results is stronger evidence than a certificate.' },
  { q: 'Is the content on AINPM.in legal or financial advice?', a: 'No. The content is general information for product managers. Regulatory summaries are for orientation only, and SEBI Circular RAG is an independent research demo that is not endorsed by SEBI. Always verify against primary sources.' },
];

const sources = [
  { href: 'https://en.wikipedia.org/wiki/India_AI_Impact_Summit_2026', label: 'India AI Impact Summit 2026 — overview' },
  { href: 'https://www.kapyn.app/blog/indiaai-mission-explained-2026', label: 'IndiaAI Mission explained (outlay, GPUs)' },
  { href: 'https://zinnov.com/centers-of-excellence/zinnov-nasscom-india-gcc-landscape-2026-report/', label: 'Zinnov–nasscom India GCC Landscape Report 2026' },
  { href: 'https://rbidocs.rbi.org.in/rdocs/PublicationReport/Pdfs/FREEAIR130820250A24FF2D4578453F824C72ED9F5D5851.PDF', label: 'RBI FREE-AI Committee Report (Aug 2025)' },
  { href: 'https://www.lexology.com/library/detail.aspx?g=ffc0c58c-3727-4472-9914-5fa6a33ffffd', label: 'MeitY AI Governance Guidelines — analysis' },
  { href: 'https://www.sansalegal.com/post/dpdp-act-2023-and-rules-2025-phased-implementation-timeline-and-business-compliance-deadlines', label: 'DPDP Act & Rules 2025 phased timeline' },
  { href: 'https://www.khaitanco.com/thought-leadership/MeitY-notifies-the-IT-Amendment-Rules-2026', label: 'MeitY IT Amendment Rules 2026 (synthetic content)' },
  { href: 'https://www.accredible.com/reports/2026-state-of-credentialing-report', label: 'Accredible — 2026 State of Credentialing Report' },
  { href: 'https://github.com/opnsrcntrbtr/sebi-circular-rag/blob/main/docs/status.md', label: 'SEBI Circular RAG — project status and eval log' },
  { href: 'https://www.indiasnews.net/news/279251495/sebi-to-soon-issue-aiml-guidelines-for-capital-markets-mandate-human-oversight-kill-switch-controls-chairman-pandey', label: 'SEBI chairman on forthcoming AI/ML guidelines (Aug 2026)' },
];

const schema = [
  {
    '@type': 'WebPage',
    '@id': 'https://ainpm.in/#webpage',
    url: 'https://ainpm.in/',
    name: 'AI-Native Product Management in India',
    isPartOf: { '@id': 'https://ainpm.in/#website' },
    about: { '@type': 'Thing', name: 'AI-native product management' },
    author: { '@id': 'https://ainpm.in/about/#ian-pinto' },
    dateModified: updated.toISOString(),
    inLanguage: 'en-IN',
  },
  faqSchema(faq),
];
---
<Base
  title="AI-Native Product Management in India | AINPM.in"
  description="Ian Pinto builds and evaluates AI-native products from India and helps teams do the same: open-source work, a practical field guide, articles and consultations."
  schema={schema}
  updated={updated}
  sources={sources}
>
  <div class="wrap hero7">
    <div>
      <h1><span class="kicker">Ian Pinto · AI-native product management</span>Building AI products people can <em>trust</em>, from India</h1>
      <p class="lede">I'm a Technical Product / Program Manager who designs, ships and evaluates AI-native products: retrieval assistants, privacy-first apps and local AI. I help product teams in India do the same.</p>
      <div class="cta">
        <a class="btn primary" href="/work/" data-goatcounter-click="cta-home-hero-work">See my work</a>
        <a class="btn ghost" href="/consult/" data-goatcounter-click="cta-home-hero-book">Book a consultation</a>
      </div>
    </div>
    <div class="feature-card">
      <figure class="shot">
        <div class="bar"><i></i><i></i><i></i><span>Featured · SEBI Circular RAG</span></div>
        <img src="https://raw.githubusercontent.com/opnsrcntrbtr/sebi-circular-rag/main/docs/assets/demo.webp" alt="SEBI Circular RAG interface showing numbered citations, in-force and superseded status for each circular, and the regulations each circular relies on" width="1512" height="806" decoding="async" fetchpriority="high">
        <figcaption>Cited answers over 1,490 SEBI circulars, with superseded circulars flagged.</figcaption>
      </figure>
      <a class="more-link" href="/sebi-rag/" style="margin-top:0">Learn more about SEBI Circular RAG</a>
    </div>
  </div>
  <div class="wrap">
    <div class="proofbar" aria-label="Proof points">
      <div><b>{PROJECTS.length}</b><span>open-source AI products</span></div>
      <div><b>0.981</b><span>abstention accuracy, SEBI RAG</span></div>
      <div><b>1</b><span>DOI-registered research preprint</span></div>
      <div><b>{evidence}</b><span>public evidence links for my skills</span></div>
    </div>
  </div>

  <section id="offer" style="border-top:0;padding-top:64px">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">What I do</span>
        <h2>Build, advise and share</h2>
      </div>
      <div class="grid g3">
        <article class="card offer">
          <span class="num">01 · Build</span>
          <h3>Open-source AI products</h3>
          <p>A SEBI regulation assistant, a zero-knowledge password manager, a passkey library with a preprint, and a local-AI study app for Mac. Each publishes its evaluation results.</p>
          <a class="more-link" href="/work/">Learn more about my work</a>
        </article>
        <article class="card offer">
          <span class="num">02 · Advise</span>
          <h3>Consultations</h3>
          <p>Paid 30-minute sessions on AI product strategy, RAG and agent evaluation, BFSI compliance-by-design, private local AI and AI PM careers.</p>
          <a class="more-link" href="/consult/" data-goatcounter-click="cta-home-offer-book">Learn more about consulting</a>
        </article>
        <article class="card offer">
          <span class="num">03 · Share</span>
          <h3>Guide and articles</h3>
          <p>A practical field guide, answer-first articles and a glossary for product managers building AI products in India.</p>
          <a class="more-link" href="/guide/">Learn more in the field guide</a>
        </article>
      </div>
    </div>
  </section>

  <section id="work">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">Featured work</span>
        <h2>Products with numbers you can check</h2>
        <p class="muted">Each card shows dated, measured results. Weak spots are shown in orange, not hidden.</p>
      </div>
      <ProjectCards />
      <a class="more-link" href="/work/">See the full portfolio</a>
    </div>
  </section>

  <section id="what">
    <div class="wrap what-grid">
      <div class="section-head">
        <span class="eyebrow">Start here</span>
        <h2>What is AI-native product management?</h2>
        <p class="answer"><strong>It is building products where an AI model is the core of the experience, not an add-on.</strong> The spec becomes an evaluation set, quality is measured as a rate, every task has a cost, and trust controls are designed in from the first sprint.</p>
        <ul class="guide-points">
          <li><span><a href="/guide/#shifts">Six shifts</a> in how a PM specifies, measures and ships</span></li>
          <li><span><a href="/guide/#radar">India's AI rules</a> with dates: DPDP consent managers start 13 Nov 2026</span></li>
          <li><span><a href="/guide/#playbook">An eight-step playbook</a> from problem to production</span></li>
          <li><span><a href="/learn/">A free six-module learning path</a>, about 24 hours, with exercises</span></li>
        </ul>
        <a class="more-link" href="/guide/">Read the field guide</a>
      </div>
      <aside class="proof-card" aria-labelledby="proof-h">
        <span class="eyebrow">Proof of skill</span>
        <h3 id="proof-h">Every skill links to evidence</h3>
        <p>Eight AI product skills, each tied to a live demo, code, evaluation results or a publication you can open.</p>
        <a class="more-link" href="/skills/" data-goatcounter-click="cta-home-skills">Learn more in the skills matrix</a>
      </aside>
    </div>
  </section>

  <section id="articles">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">Latest articles</span>
        <h2>Guides for AI-native product managers</h2>
      </div>
      <div class="grid g3">
        {latest.map((a) => (
          <a class="card" href={`/articles/${a.id}/`}>
            <span class="meta">{a.data.tags[0]} · {a.data.readingMinutes} min read</span>
            <h3>{a.data.title}</h3>
            <p>{a.data.description}</p>
            <span class="more">Read the article →</span>
          </a>
        ))}
      </div>
      <a class="more-link" href="/articles/">All articles</a>
    </div>
  </section>

  <section id="faq">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">FAQ</span>
        <h2>Frequently asked questions</h2>
      </div>
      <div class="faq">
        {faq.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
      <BookCTA id="home" heading="Building an AI-native product?" text="Book a 30-minute consultation on strategy, evaluation, compliance-by-design, private local AI or your AI PM career." />
    </div>
  </section>
</Base>
