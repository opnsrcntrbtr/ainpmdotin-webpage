---
import Base from '../../layouts/Base.astro';
import ProjectCards from '../../components/ProjectCards.astro';
import SkillProjectMap from '../../components/SkillProjectMap.astro';
import Scorecard from '../../components/Scorecard.astro';
import BookCTA from '../../components/BookCTA.astro';
import { PROJECTS } from '../../data/projects';
import { SKILLS } from '../../data/skills';
import { LINKS } from '../../data/graph';
import { breadcrumb } from '../../data/site';
import { CONTRIBUTIONS, contributionsCheckedOn } from '../../data/contributions';
const prs = CONTRIBUTIONS.filter((c) => c.kind === 'merged-pr');
const pkgs = CONTRIBUTIONS.filter((c) => c.kind === 'package');
const fmtD = (d: string) => new Date(d).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });

const updated = new Date('2026-11-05');
const evidence = SKILLS.reduce((n, s) => n + s.evidence.length, 0);
const schema = [
  {
    '@type': 'CollectionPage',
    '@id': 'https://ainpm.in/work/#page',
    name: 'Portfolio of Ian Pinto',
    url: 'https://ainpm.in/work/',
    isPartOf: { '@id': 'https://ainpm.in/#website' },
    author: { '@id': 'https://ainpm.in/about/#ian-pinto' },
    dateModified: updated.toISOString(),
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: PROJECTS.map((p, i) => ({ '@type': 'ListItem', position: i + 1, name: p.name, url: 'https://ainpm.in' + p.href })),
    },
  },
  breadcrumb([{ name: 'Home', path: '/' }, { name: 'Work', path: '/work/' }]),
];
---
<Base
  title="Portfolio: AI-Native and Privacy-First Products | AINPM.in"
  description="Ian Pinto's portfolio: SEBI Circular RAG, TrustVault, the webauthn-prf-zktv library and preprint, Lecture Lens, CodeSearchNet search, and open-source contributions."
  schema={schema}
  updated={updated}
>
  <div class="wrap crumb"><a href="/">AINPM.in</a> / Work</div>
  <div class="wrap page-head">
    <span class="eyebrow">Portfolio · Updated 5 Nov 2026</span>
    <h1>Products I've built and shipped</h1>
    <p class="answer"><strong>Five open-source products by Ian Pinto: an AI assistant for SEBI regulation, a zero-knowledge password manager, a passkey cryptography library with a research preprint, a local-AI study app for macOS, and fine-tuned code search.</strong> Each card shows dated numbers. Open a case study to see the trust design and trade-offs.</p>
  </div>
  <div class="wrap">
    <div class="glance">
      <div><b>{PROJECTS.length}</b><span>open-source products</span></div>
      <div><b>1</b><span>DOI-registered preprint</span></div>
      <div><b>{LINKS.length}</b><span>skill-to-project connections</span></div>
      <div><b>{evidence}</b><span>public evidence links</span></div>
    </div>
  </div>

  <section id="projects" style="border-top:0;padding-top:40px">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">01 · Products</span>
        <h2>What does each product prove?</h2>
        <p class="muted">Bars show measured rates; orange marks a known weak spot. Numbers are as of the dates on each case study.</p>
      </div>
      <ProjectCards heading="h3" />
    </div>
  </section>

  <section id="flagship">
    <div class="wrap viz-grid two">
      <div>
        <div class="section-head">
          <span class="eyebrow">02 · Flagship results</span>
          <h2>How good is the flagship product?</h2>
          <p class="muted">SEBI Circular RAG has to clear six quality floors before any change ships. The tick on each bar is the floor; the bar is the measured result.</p>
          <p><a class="more-link" href="/sebi-rag/">Learn more in the SEBI RAG case study</a></p>
        </div>
      </div>
      <Scorecard slug="sebi-rag" />
    </div>
  </section>

  <section id="map">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">03 · Skills</span>
        <h2>Which skills does the portfolio prove?</h2>
        <p class="muted">Every line is a public evidence link from the <a href="/skills/">skills matrix</a>. Select a skill to see its proof.</p>
      </div>
      <SkillProjectMap id="work-map" />
    </div>
  </section>

  <section id="open-source">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">04 · Open source</span>
        <h2>What have I contributed to other open-source projects?</h2>
        <p class="muted">Merged pull requests to projects I don't own, and small packages I publish and maintain. Only merged pull requests are listed. Download counts are small and stated as they are; checked {fmtD(contributionsCheckedOn)}.</p>
      </div>
      <div class="tbl-wrap">
        <table class="os-tbl">
          <thead><tr><th scope="col">Merged pull request</th><th scope="col">Project</th><th scope="col">Merged</th><th scope="col">What changed</th></tr></thead>
          <tbody>
            {prs.map((c) => (<tr><td><a href={c.href} target="_blank" rel="noopener">{c.title} ↗</a></td><td>{c.project}</td><td class="v">{fmtD(c.date)}</td><td>{c.summary}</td></tr>))}
          </tbody>
        </table>
      </div>
      <div class="tbl-wrap" style="margin-top:20px">
        <table class="os-tbl">
          <thead><tr><th scope="col">Package</th><th scope="col">Registry</th><th scope="col">First published</th><th scope="col">What it does</th><th scope="col">Recent downloads</th></tr></thead>
          <tbody>
            {pkgs.map((c) => (<tr><td><a href={c.href} target="_blank" rel="noopener">{c.title} ↗</a></td><td>{c.project}</td><td class="v">{fmtD(c.date)}</td><td>{c.summary}</td><td>{c.stat}</td></tr>))}
          </tbody>
        </table>
      </div>
      <p class="note">All {PROJECTS.length} case studies above and every package are on <a href="https://github.com/opnsrcntrbtr" target="_blank" rel="noopener">GitHub ↗</a> and <a href="https://huggingface.co/opnsrcntrbtrian" target="_blank" rel="noopener">Hugging Face ↗</a>. A machine-readable version is at <a href="/portfolio.json">/portfolio.json</a>.</p>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">05 · Common threads</span>
        <h2>What do these projects have in common?</h2>
      </div>
      <div class="grid g3">
        <article class="card"><h3>Evidence before claims</h3><p>Every project ships with tests or evaluations, and publishes its weak numbers alongside the strong ones.</p></article>
        <article class="card"><h3>Privacy by architecture</h3><p>Keys stay on the device, models run locally, and storage alone is never enough to read user data.</p></article>
        <article class="card"><h3>Decisions written down</h3><p>Rejected ideas, threat models and architecture decision records are part of the product, not an afterthought.</p></article>
      </div>
      <BookCTA id="work" heading="Want a second pair of eyes on your product?" text="Book a 30-minute consultation on AI product strategy, evaluation, privacy-first architecture or local AI." />
    </div>
  </section>
</Base>
