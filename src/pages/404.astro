  <div class="wrap page-head" style="padding:72px 16px 96px">
    <span class="eyebrow">404</span>
    <h1>That page isn't here</h1>
    <p class="lede muted">The link may be old or mistyped. Try one of these instead.</p>
    <div class="cta" style="margin-top:20px">
      <a class="btn primary" href="/">Home</a>
      <a class="btn ghost" href="/sebi-rag/">SEBI RAG case study</a>
      <a class="btn ghost" href="/articles/">Articles</a>
      <a class="btn ghost" href="/glossary/">Glossary</a>
    </div>
  </div>
</Base>
