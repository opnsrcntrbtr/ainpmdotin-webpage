---
// Theme-aware layered architecture diagram rendered as inline SVG.
interface Layer { title: string; items: string; trust?: boolean; }
interface Props { layers: Layer[]; title: string; desc: string; caption?: string; }
const { layers, title, desc, caption } = Astro.props;
const W = 760, H = 64, GAP = 30, PAD = 6;
const height = layers.length * H + (layers.length - 1) * GAP + PAD * 2;
const id = 'd' + Math.abs([...title].reduce((a, c) => (a * 31 + c.charCodeAt(0)) | 0, 7)).toString(36);
---
<figure class="diagram">
  <svg viewBox={`0 0 ${W} ${height}`} role="img" aria-labelledby={`${id}t ${id}d`} xmlns="http://www.w3.org/2000/svg">
    <title id={`${id}t`}>{title}</title>
    <desc id={`${id}d`}>{desc}</desc>
    <defs>
      <marker id={`${id}a`} viewBox="0 0 10 10" refX="5" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0,0 L10,5 L0,10 z" style="fill:var(--ink-2)" />
      </marker>
    </defs>
    {layers.map((l, i) => {
      const y = PAD + i * (H + GAP);
      return (
        <g>
          <rect x="2" y={y} width={W - 4} height={H} rx="12" style={`fill:${l.trust ? 'var(--accent-soft)' : 'var(--surface)'};stroke:${l.trust ? 'var(--saffron)' : 'var(--line)'};stroke-width:1.5`} />
          <text x="24" y={y + 27} style="font:600 17px var(--serif);fill:var(--ink)">{l.title}</text>
          <text x="24" y={y + 49} style="font:400 13.5px var(--sans);fill:var(--ink-2)">{l.items}</text>
          {i < layers.length - 1 && (
            <line x1={W / 2} y1={y + H + 3} x2={W / 2} y2={y + H + GAP - 5} style="stroke:var(--ink-2);stroke-width:1.5" marker-end={`url(#${id}a)`} />
          )}
        </g>
      );
    })}
  </svg>
  {caption && <figcaption>{caption}</figcaption>}
</figure>
